# Plantilla de credenciales de Olegario.
# 1. Copia este archivo como .env  ->  cp .env.example .env
# 2. Rellena los valores reales SOLO en .env (ese archivo no se sube a GitHub).
# Aquí nunca van valores reales.

# --- General ---
APP_ENV=development
APP_PORT=3000

# --- Base de datos ---
DB_HOST=localhost
